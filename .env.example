APP_NAME="SIAP Desa"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://127.0.0.1:8088

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=siap_desa_local
DB_USERNAME=root
DB_PASSWORD=

CENTRAL_DB_CONNECTION=mysql
CENTRAL_DB_HOST=
CENTRAL_DB_PORT=3306
CENTRAL_DB_DATABASE=siap_desa_cloud
CENTRAL_DB_USERNAME=
CENTRAL_DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=1440
SIAP_DATA_PATH="C:/ProgramData/SIAP Desa"
SIAP_DEVICE_UUID=
SIAP_VILLAGE_UUID=
CENTRAL_API_URL=
CENTRAL_API_KEY=
SYNC_ENABLED=true
SYNC_BATCH_SIZE=100
SYNC_INTERVAL_SECONDS=60
AUTO_BACKUP=true
